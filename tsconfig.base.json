{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@saas/db-schema": ["packages/db-schema/src/index.ts"],
      "@saas/api-ai": ["packages/api-ai/src/index.ts"],
      "@saas/api-core": ["packages/api-core/src/index.ts"]
    }
  }
}
