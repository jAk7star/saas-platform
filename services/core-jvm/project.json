{
  "name": "core-jvm",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/core-jvm/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gradlew.bat build -x test",
        "cwd": "services/core-jvm"
      }
    },
    "export-openapi": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gradlew.bat exportOpenApi",
        "cwd": "services/core-jvm"
      },
      "outputs": ["{projectRoot}/dist/openapi-core.json"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gradlew.bat test",
        "cwd": "services/core-jvm"
      }
    }
  }
}
