# PostgreSQL Local (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=saas_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_db

# Better Auth
BETTER_AUTH_SECRET=change-me-in-production-32-chars-min
BETTER_AUTH_URL=http://localhost:3000

# Serviços Internos
AI_ETL_URL=http://localhost:8000
CORE_JVM_URL=http://localhost:8080
