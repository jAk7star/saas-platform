{
  "name": "api-ai",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/api-ai/src",
  "projectType": "library",
  "targets": {
    "generate-client": {
      "dependsOn": ["ai-etl:export-openapi"],
      "executor": "nx:run-commands",
      "options": {
        "command": "openapi-ts",
        "cwd": "packages/api-ai"
      },
      "outputs": ["{projectRoot}/src/generated"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/api-ai"
      }
    }
  }
}
